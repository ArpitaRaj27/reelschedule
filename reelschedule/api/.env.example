# Copy to api/.env for local development. Never commit api/.env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres@localhost:5432/reelschedule
CORS_ORIGINS=http://localhost:5173
FESTIVAL_TIMEZONE=America/Chicago
DEFAULT_BUFFER_MINUTES=15

# Local tokens: run `npm run dev-token -w api -- programmer` once to create these keys.
DEV_AUTH_JWKS_FILE=.dev-auth/jwks.json

# Production / Entra ID (leave DEV_AUTH_JWKS_FILE unset there):
# AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_AUDIENCE=api://<api-app-client-id>
# AUTH_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# TMDB "API Read Access Token" (v4 bearer). Server-side only; never expose to the browser.
TMDB_READ_TOKEN=
TMDB_TIMEOUT_MS=3000
TMDB_MAX_RETRIES=2
